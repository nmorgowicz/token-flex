# token-flex configuration — copy to .env or export from your shell / launcher.
# Every variable is optional; the defaults in parentheses are used when unset.

# Registry file that maps project names to session directories.
# (default: <PI_CODING_AGENT_DIR>/registers/projects.json)
#PI_PROJECT_REGISTRY=

# Project name used for session_start registration and the default /tokens scope.
# (default: basename of the working directory)
#PI_PROJECT_NAME=

# Optional discovery root: one subdirectory per project, each containing a
# `sessions/` directory. Used by `/tokens --all` in addition to the registry.
#PI_PROJECTS_ROOT=

# pi agent directory.
# (default: ~/.pi/agent)
#PI_CODING_AGENT_DIR=

# Session storage override.
# (default: <PI_CODING_AGENT_DIR>/sessions)
#PI_CODING_AGENT_SESSION_DIR=
